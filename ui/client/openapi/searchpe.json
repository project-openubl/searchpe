            "type" : "string"
          },
          "tipoZona" : {
            "type" : "string"
          },
          "numero" : {
            "type" : "string"
          },
          "interior" : {
            "type" : "string"
          },
          "lote" : {
            "type" : "string"
          },
          "departamento" : {
            "type" : "string"
          },
          "manzana" : {
            "type" : "string"
          },
          "kilometro" : {
            "type" : "string"
          }
        }
      },
      "Date" : {
        "type" : "string",
        "format" : "date",
        "examples" : [ "2022-03-10" ]
      },
      "Meta" : {
        "type" : "object",
        "properties" : {
          "offset" : {
            "type" : "integer",
            "format" : "int32"
          },
          "limit" : {
            "type" : "integer",
            "format" : "int32"
          },
          "count" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
