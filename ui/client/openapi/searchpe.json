          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "fullName" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string",
            "pattern" : "^[a-zA-Z0-9._-]{3,}$",
            "minLength" : 3,
            "maxLength" : 250
          },
          "password" : {
            "type" : "string",
            "minLength" : 3,
            "maxLength" : 250
          },
          "permissions" : {
            "type" : "array",
            "uniqueItems" : true,
            "items" : {
              "type" : "string"
            },
            "minItems" : 1
          }
        },
        "required" : [ "username", "password", "permissions" ]
      },
      "BasicUserPasswordChangeDto" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string"
          }
        }
      },
