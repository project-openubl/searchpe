{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vitest/globals", "@rsbuild/core/types"],
    "paths": {
      "api/*": ["./src/api/*"],
      "api-client": ["./src/api-client"],
      "api-client/*": ["./src/api-client/*"],
      "images/*": ["./src/images/*"],
      "pages/*": ["./src/pages/*"],
      "queries/*": ["./src/queries/*"],
      "shared/*": ["./src/shared/*"],
      "utils/*": ["./src/utils/*"],
      "Constants": ["./src/Constants"],
      "Paths": ["./src/Paths"]
    }
  },
  "include": ["src", "rsbuild.config.ts", "vitest.config.ts"]
}
