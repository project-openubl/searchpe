{
  "name": "searchpe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"cypress/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"cypress/**/*.ts\"",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "prod": "npm run build && rsync -a build/* ../resources/META-INF/resources"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@patternfly/patternfly": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@patternfly/react-tokens": "^6.7.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axios-mock-adapter": "^2.1.0",
    "cypress": "^16.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "cypress": true
  }
}
