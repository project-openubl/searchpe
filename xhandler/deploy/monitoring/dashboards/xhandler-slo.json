{
  "title": "xhandler-service SLOs",
  "uid": "xhandler-slo",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "OSE: oldest CDR-OSE waiting to be forwarded (limit 1 h)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(xhandler_ose_forward_oldest_seconds)",
          "legendFormat": "oldest",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "OSE: forwarding delay p50 / p99 / max",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(xhandler_ose_forward_delay_seconds_bucket[15m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(xhandler_ose_forward_delay_seconds_bucket[15m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "expr": "max(xhandler_ose_forward_delay_seconds_max)",
          "legendFormat": "max",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "OSE: submissions by result",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(xhandler_ose_submissions_total[5m])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "OSE intake availability (5m)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - sum(rate(http_server_requests_seconds_count{uri=~\"/ose/billService|/ol-ti-itcpfegem/billService|/api/v1/ose/documents\",outcome=\"SERVER_ERROR\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=~\"/ose/billService|/ol-ti-itcpfegem/billService|/api/v1/ose/documents\"}[5m])), 1)",
          "legendFormat": "availability",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Documents needing a person",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(xhandler_documents_exception)",
          "legendFormat": "exception",
          "refId": "A"
        },
        {
          "expr": "max(xhandler_documents_unknown_stale)",
          "legendFormat": "unknown > 1h",
          "refId": "B"
        },
        {
          "expr": "max(xhandler_documents_past_deadline)",
          "legendFormat": "past deadline",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Documents waiting for SUNAT",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(xhandler_documents_pending)",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "SUNAT attempts by mode",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(xhandler_sunat_attempts_total[5m])) by (mode)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Jobs: waiting and oldest",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(xhandler_jobs_waiting)",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "expr": "max(xhandler_jobs_oldest_waiting_seconds)",
          "legendFormat": "oldest (s)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "API: requests and 5xx",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{outcome=\"SERVER_ERROR\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "API: latency p99 by uri",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "PSE rejected-CDR rate (half-year)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(xhandler_pse_rejected_rate)",
          "legendFormat": "rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Job run time p99 by job",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(xhandler_jobs_run_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ],
  "tags": [
    "xhandler"
  ]
}
